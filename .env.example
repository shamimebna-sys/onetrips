# Copy to .env and fill in environment-specific values.
# Never use production credentials in development.
# This root file is the single source of truth. Do not copy it into apps/.
# `npm run dev` / `npm run dev:all` load it and Turbo passes server vars into Next.js.

# --- Database (PostgreSQL is the only primary relational database) ---
DATABASE_URL="postgresql://onetrips:onetrips@localhost:5432/onetrips"
# Docker Compose (optional overrides; never hard-code production credentials)
# POSTGRES_DB=onetrips
# POSTGRES_USER=onetrips
# POSTGRES_PASSWORD=onetrips
# One-time MySQL → PostgreSQL import only. Not used by the apps.
# MYSQL_DATABASE_URL="mysql://onetrips:onetrips@localhost:3306/onetrips"
# POSTGRES_ADMIN_URL=postgresql://postgres:postgres@localhost:5432/postgres
# Optional. Used only to CREATE/DROP restore-drill databases when the app role lacks CREATEDB.

# --- Redis (cache, sessions, queues, rate limits) ---
REDIS_URL="redis://localhost:6379"
FLIGHT_SEARCH_TTL_SECONDS="1200"
HOTEL_SEARCH_TTL_SECONDS="1200"

# --- Logging / errors (optional) ---
LOG_LEVEL="debug"
# SENTRY_DSN=
# SENTRY_ENVIRONMENT="development"
# Allow placeholder secrets with `next start` locally. Never set this in a real deploy.
# OT_ALLOW_DEV_SECRETS=1

# --- Auth ---
JWT_SECRET="replace-with-long-random-string"
JWT_ACCESS_SECRET="replace-with-long-random-string"
JWT_REFRESH_SECRET="replace-with-long-random-string"

# 32-byte AES key as 64 hex chars. Required in production for passport encryption.
ENCRYPTION_KEY=""

# Bootstrap Super Admin on first seed (leave password empty to skip)
ADMIN_BOOTSTRAP_EMAIL="admin@onetrips.com"
ADMIN_BOOTSTRAP_PASSWORD=""

# Bootstrap demo B2B agency on first seed (leave password empty to skip)
B2B_BOOTSTRAP_EMAIL="agency@onetrips.com"
B2B_BOOTSTRAP_PASSWORD=""

# --- App ---
NEXT_PUBLIC_APP_NAME="ONETRIPS"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3001"
NEXT_PUBLIC_B2B_URL="http://localhost:3002"

# --- Payments (HMAC for gateway webhooks). Required in production. ---
PAYMENT_WEBHOOK_SECRET="replace-with-long-random-string"

# --- Providers (Phase 14A: mock only — do not set real GDS keys) ---
FLIGHT_PROVIDER="mock"
MOCK_GDS_SCENARIO="SUCCESS"
HOTEL_PROVIDER="mock"
MOCK_HOTEL_SCENARIO="SUCCESS"
GDS_SEARCH_TIMEOUT_MS="15000"
GDS_REVALIDATION_TIMEOUT_MS="10000"
GDS_BOOKING_TIMEOUT_MS="20000"
GDS_TICKETING_TIMEOUT_MS="20000"
GDS_CANCELLATION_TIMEOUT_MS="15000"
# GDS_CIRCUIT_FAILURE_THRESHOLD="5"
# GDS_CIRCUIT_OPEN_MS="30000"
# GDS_RETRY_LIMIT="2"
# PAYMENT_GATEWAY_KEY=
# --- Email (leave SMTP_HOST empty to print messages in the console / worker) ---
# SMTP_HOST=
# SMTP_PORT="587"
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="ONETRIPS <noreply@onetrips.com>"

# --- SMS (leave SMS_API_URL empty to print SMS in the console / worker) ---
# SMS_API_URL=
# SMS_API_KEY=
# SMS_FROM="ONETRIPS"

# --- Notification worker ---
# Set to 1 to send immediately in the API process (no Redis worker).
# NOTIFY_INLINE=

# --- PostgreSQL backups (Phase 17). Production must copy offsite. ---
# BACKUP_DIR="./backups"
# BACKUP_RETENTION_DAYS="14"
# Second disk/mount or rclone remote — required when BACKUP_OFFSITE_REQUIRED=YES
# BACKUP_OFFSITE_DIR="./backups/offsite"
# BACKUP_RCLONE_REMOTE=
# BACKUP_OFFSITE_REQUIRED="NO"
# RESTORE_DATABASE="NO"
# RESTORE_FILE=
# RESTORE_DRILL_DB="onetrips_restore_drill"
# ACCEPTANCE_SKIP_DRILL="NO"

# --- Playwright B2C E2E (local/test only; never production credentials) ---
# Dedicated port so tests do not reuse another app on :3000.
# PLAYWRIGHT_PORT="3100"
# PLAYWRIGHT_BASE_URL="http://localhost:3100"
# E2E_CUSTOMER_EMAIL="e2e.customer@onetrips.test"
# E2E_CUSTOMER_PASSWORD="E2eCustomer#14D"
# E2E_CUSTOMER_B_EMAIL="e2e.customer.b@onetrips.test"
# E2E_CUSTOMER_B_PASSWORD="E2eCustomerB#14D"


